{
  "name": "Collection",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "default": "Guardados"
    },
    "template_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "owner_user_id",
    "name"
  ],
  "rls": {
    "create": { "data.owner_user_id": "{{user.id}}" },
    "read": { "data.owner_user_id": "{{user.id}}" },
    "update": { "data.owner_user_id": "{{user.id}}" },
    "delete": { "data.owner_user_id": "{{user.id}}" }
  }
}