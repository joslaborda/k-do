{
  "name": "CountryInfo",
  "type": "object",
  "properties": {
    "country_label": {
      "type": "string",
      "description": "Nombre del pa\u00eds en espa\u00f1ol (ej: Jap\u00f3n, Reino Unido)"
    },
    "country_code": {
      "type": "string",
      "description": "C\u00f3digo ISO 3166-1 alpha-2 (ej: JP, GB)"
    },
    "top_cities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de las 20 ciudades m\u00e1s tur\u00edsticas"
    },
    "emergency_info": {
      "type": "object",
      "description": "Informaci\u00f3n de emergencias y embajada generada por IA"
    }
  },
  "required": [
    "country_label"
  ],
  "rls": {
    // Caché compartida de info de emergencias/embajadas por país — de solo
    // lectura desde el cliente (confirmado: src/ solo hace .filter(), nunca
    // .create()/.update()). Sin este bloque no había ninguna restricción:
    // cualquier usuario autenticado podía crear/editar/borrar estas filas y
    // alterar los datos de emergencia mostrados a TODOS los usuarios de un
    // país — vector de vandalismo con impacto real (números de emergencia
    // falsos), no solo de datos. Cerrado del todo desde el cliente; si en el
    // futuro hace falta regenerarlas, debe hacerse con asServiceRole desde
    // una función backend, no desde aquí.
    "create": false,
    "read": true,
    "update": false,
    "delete": false
  }
}