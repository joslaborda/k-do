{
  "name": "ExchangeRateCache",
  "type": "object",
  "properties": {
    "base": { "type": "string", "description": "Moneda origen (ISO 4217)" },
    "quote": { "type": "string", "description": "Moneda destino (ISO 4217)" },
    "rate": { "type": "number", "description": "Tasa de cambio (1 base = rate quote)" },
    "fetched_at": { "type": "string", "format": "date-time", "description": "Timestamp de obtención" },
    "valid_until": { "type": "string", "format": "date-time", "description": "Válido hasta" },
    "source": { "type": "string", "description": "Fuente: frankfurter/ECB, llm/internet, etc." }
  },
  "required": ["base", "quote", "rate"],
  "rls": {
    // El panel de seguridad de Base44 marca este hallazgo como CRÍTICO:
    // "los usuarios públicos pueden acceder a todos los registros de
    // ExchangeRateCache" — es sobre LECTURA. En la ronda 3 se cerraron
    // create/update (moviendo la escritura a la función backend
    // cacheFxRate) pero se dejó "read": true a propósito, asumiendo que un
    // tipo de cambio no es información sensible — ese razonamiento no es lo
    // que el panel evalúa: cualquier acceso público sin restricción se
    // marca, sea cual sea el contenido. Mismo límite de fondo que ya se
    // documentó para create/update: el motor de rls de Base44 no puede
    // expresar "cualquier usuario autenticado, pero no público" como
    // predicado (solo compara contra la identidad del usuario actual, o
    // true/false a secas), y esta entidad no tiene ningún campo de "dueño"
    // contra el que comparar. La única forma real de cerrarlo del todo es
    // mover también la lectura a una función backend (getCachedFxRate) que
    // exige sesión real — ver base44/functions/getCachedFxRate/entry.ts y
    // src/lib/fxRates.js. create/read/update/delete quedan todos cerrados
    // desde el cliente; todo el acceso pasa por las dos funciones backend
    // (cacheFxRate para escribir, getCachedFxRate para leer), ambas con
    // asServiceRole.
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
