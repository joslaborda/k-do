{
  "name": "ExchangeRateCache",
  "type": "object",
  "properties": {
    "base": { "type": "string", "description": "Moneda origen (ISO 4217)" },
    "quote": { "type": "string", "description": "Moneda destino (ISO 4217)" },
    "rate": { "type": "number", "description": "Tasa de cambio (1 base = rate quote)" },
    "fetched_at": { "type": "string", "format": "date-time", "description": "Timestamp de obtención" },
    "valid_until": { "type": "string", "format": "date-time", "description": "Válido hasta" },
    "source": { "type": "string", "description": "Fuente: frankfurter/ECB, llm/internet, etc." }
  },
  "required": ["base", "quote", "rate"],
  "rls": {
    // El panel de seguridad de Base44 marcó como CRÍTICO ("usuarios públicos
    // pueden acceder a todos los registros") tener create/update abiertos sin
    // restricción — antes se había dejado así a propósito porque el cliente
    // necesitaba escribir en esta caché compartida y el motor de rls no
    // puede validar el VALOR de "rate" ni expresar "cualquier autenticado,
    // pero no público". Ahora la escritura se movió a la función backend
    // cacheFxRate (exige sesión real, valida rate/base/quote, limpia
    // duplicados) — ver base44/functions/cacheFxRate/entry.ts y
    // src/lib/fxRates.js. Create/update quedan cerrados del todo desde el
    // cliente; read sigue abierto porque src/lib/fxRates.js lee la caché
    // directo con .filter() y es información no sensible (tipos de cambio
    // públicos, no ligados a ningún usuario).
    "create": false,
    "read": true,
    "update": false,
    "delete": false
  }
}
