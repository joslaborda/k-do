{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "feedback_type": {
      "type": "string",
      "enum": [
        "bug",
        "suggestion",
        "other"
      ],
      "description": "Categoría elegida por el usuario en el formulario de Ayuda y sugerencias"
    },
    "message": {
      "type": "string",
      "description": "Texto libre escrito por el usuario"
    },
    "user_email": {
      "type": "string",
      "description": "Email de quien envía — copiado en el momento del envío para no depender de joins si el usuario borra la cuenta después"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre visible de quien envía, en el momento del envío"
    },
    "app_language": {
      "type": "string",
      "description": "Idioma activo en la app cuando se envió — útil para saber en qué idioma responder"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "read"
      ],
      "default": "new",
      "description": "Se revisa manualmente desde el panel de datos de base44 — no hay bandeja dentro de la app"
    }
  },
  "required": [
    "feedback_type",
    "message",
    "user_email"
  ],
  "rls": {
    // create exigía solo sesión iniciada, no que user_email coincidiera con
    // quien llama — cualquier usuario podía mandar feedback con el
    // user_email/user_name de otra persona en el body, atribuyéndole quejas
    // o "bugs" falsos de cara al equipo de soporte (que lee esto desde el
    // panel de datos de base44, no hay bandeja dentro de la app). Impacto
    // bajo porque read ya exigía autoría (nadie más podía LEER el mensaje
    // ajeno), pero se cierra igual la creación, mismo patrón que
    // Like/SpotComment.
    "create": { "data.user_email": "{{user.email}}" },
    "read": { "data.user_email": "{{user.email}}" },
    "update": false,
    "delete": false
  }
}
