{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id":            { "type": "string" },
    "type":               { "type": "string" },
    "read":               { "type": "boolean", "default": false },
    "actor_display_name": { "type": "string" },
    "actor_username":     { "type": "string" },
    "actor_avatar":       { "type": "string" },
    "trip_id":            { "type": "string" },
    "trip_name":          { "type": "string" },
    "ref_id":             { "type": "string", "description": "ID del objeto referenciado (doc, spot, etc.)" },
    "ref_title":          { "type": "string" },
    "ref_extra":          { "type": "string", "description": "Datos extra JSON (ej: fecha del spot)" }
  },
  "required": ["user_id", "type"],
  "rls": {
    // Riesgo aceptado, documentado (no se cierra del todo en esta ronda): a
    // diferencia de Like/SpotComment/TripMessage (donde "create" se cerró
    // exigiendo data.user_id === {{user.id}}), aquí esa misma regla rompería
    // la función normal de una notificación — se crea SIEMPRE con el
    // user_id del DESTINATARIO, no de quien la genera (11 sitios en src/
    // llaman a notify() para avisar a otro miembro de un like, comentario,
    // invitación, etc.), así que no hay ningún campo de esta entidad que el
    // rls pueda comparar de forma útil contra {{user.id}}/{{user.email}} de
    // quien llama. Cualquier usuario autenticado puede en teoría crear una
    // notificación falsa (actor/tipo/texto arbitrarios) dirigida a cualquier
    // otro usuario — vector de spam/ingeniería social, pero sin acceso a
    // datos ajenos (read/update/delete siguen exigiendo ser el destinatario)
    // y sin que ningún flujo sensible (aceptar invitación, etc.) confíe en
    // el contenido de una notificación para autorizar nada. Cerrarlo del
    // todo requeriría mover la creación de notificaciones a las funciones
    // backend que ya validan la acción real de origen (p. ej. emitir
    // "member_joined" desde acceptTripInvite con asServiceRole) — refactor
    // de los 11 sitios que llaman notify(), no se ha hecho aquí.
    "create": true,
    "read": { "data.user_id": "{{user.id}}" },
    "update": { "data.user_id": "{{user.id}}" },
    "delete": { "data.user_id": "{{user.id}}" }
  }
}