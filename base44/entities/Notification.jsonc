{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id":            { "type": "string" },
    "type":               { "type": "string" },
    "read":               { "type": "boolean", "default": false },
    "actor_display_name": { "type": "string" },
    "actor_username":     { "type": "string" },
    "actor_avatar":       { "type": "string" },
    "trip_id":            { "type": "string" },
    "trip_name":          { "type": "string" },
    "ref_id":             { "type": "string", "description": "ID del objeto referenciado (doc, spot, etc.)" },
    "ref_title":          { "type": "string" },
    "ref_extra":          { "type": "string", "description": "Datos extra JSON (ej: fecha del spot)" }
  },
  "required": ["user_id", "type"],
  "rls": {
    // Antes "create": true sin restricción — el rls no puede expresar "solo
    // si quien llama y el destinatario son miembros del mismo viaje" (una
    // notificación se crea con el user_id del DESTINATARIO, no de quien la
    // genera, y esa validación requiere leer Trip/TripInvite, algo que el
    // motor de rls no puede hacer). Se cerró moviendo la creación a la
    // función backend createNotification, que sí valida esa relación con
    // asServiceRole y deriva el "actor" del perfil real de quien llama (ver
    // base44/functions/createNotification/entry.ts y src/lib/notifications.js).
    // read/update/delete siguen igual que antes: solo el destinatario.
    "create": false,
    "read": { "data.user_id": "{{user.id}}" },
    "update": { "data.user_id": "{{user.id}}" },
    "delete": { "data.user_id": "{{user.id}}" }
  }
}