{
  "name": "SpotComment",
  "type": "object",
  "description": "Comentario y valoraci\u00f3n de un usuario sobre un spot",
  "properties": {
    "spot_id": {
      "type": "string",
      "description": "ID del spot"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario"
    },
    "user_display_name": {
      "type": "string",
      "description": "Nombre visible del usuario"
    },
    "username": {
      "type": "string",
      "description": "Username del usuario"
    },
    "user_avatar": {
      "type": "string",
      "description": "URL del avatar del usuario"
    },
    "thumb": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ],
      "description": "Valoraci\u00f3n thumbs up o down"
    },
    "text": {
      "type": "string",
      "description": "Texto del comentario (opcional)"
    },
    "image_url": {
      "type": "string",
      "description": "URL de foto adjunta (opcional)"
    }
  },
  "required": [
    "spot_id",
    "user_id",
    "thumb"
  ],
  "rls": {
    // Mismo patrón que ya se corrigió en Follow.jsonc: create:true sin
    // exigir autoría dejaba que cualquiera publicara una reseña/valoración
    // "firmada" con la identidad de otro usuario real (más grave que en
    // Like porque aquí hay texto público persistente, no solo un contador).
    //
    // Límite conocido, no resuelto aquí: read/create tampoco comprueban la
    // visibilidad del Spot padre (spot_id) — si alguien conoce/filtra el id
    // de un spot personal o compartido al que ya no tiene acceso, puede
    // seguir leyendo/comentando sus comentarios. base44 rls no permite
    // condiciones cross-entity (no puede mirar Spot.visibility desde aquí);
    // cerrarlo del todo requeriría mover la creación/lectura de comentarios
    // a una función backend con asServiceRole, como se hizo con TripInvite.
    "create": { "data.user_id": "{{user.id}}" },
    "read": true,
    "update": { "data.user_id": "{{user.id}}" },
    "delete": { "data.user_id": "{{user.id}}" }
  }
}