{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID del usuario (base44 user.id)"
    },
    "email": {
      "type": "string",
      "description": "Email del usuario — copia del User.email para evitar joins"
    },
    "username": {
      "type": "string",
      "description": "Username único (minúsculas, a-z0-9_)"
    },
    "username_normalized": {
      "type": "string",
      "description": "Username normalizado en minúsculas para unicidad"
    },
    "display_name": {
      "type": "string",
      "description": "Nombre visible"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL del avatar"
    },
    "cover_image_url": {
      "type": "string",
      "description": "URL de la foto de portada del perfil"
    },
    "bio": {
      "type": "string",
      "description": "Biografía corta (hasta 300 caracteres)"
    },
    "website": {
      "type": "string",
      "description": "Enlace personal o blog de viajes"
    },
    "instagram": {
      "type": "string",
      "description": "Username de Instagram (sin @)"
    },
    "home_country": {
      "type": "string",
      "default": "España",
      "description": "País de origen"
    },
    "home_currency": {
      "type": "string",
      "description": "Moneda preferida"
    },
    "travel_style": {
      "type": "string",
      "enum": [
        "mochilero",
        "confort",
        "lujo",
        "aventura",
        "cultural",
        "gastronómico"
      ],
      "description": "Estilo de viaje preferido"
    },
    "default_spot_visibility": {
      "type": "string",
      "enum": [
        "trip_members",
        "personal"
      ],
      "default": "trip_members"
    },
    "default_doc_visibility": {
      "type": "string",
      "enum": [
        "trip_members",
        "personal"
      ],
      "default": "trip_members"
    },
    "nationality": {
      "type": "string",
      "description": "Nacionalidad del usuario — determina requisitos de visado"
    },
    "second_nationality": {
      "type": "string",
      "description": "Segunda nacionalidad (doble pasaporte) — se usa para ofrecer los requisitos de visado más favorables"
    },
    "language": {
      "type": "string",
      "description": "Idioma preferido de la interfaz"
    },
    "notif_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Recibir notificaciones push de la app -- interruptor único que sustituye a los antiguos notif_invites/notif_expenses (Settings.jsx tenia dos toggles separados, demasiado granular; ahora es uno solo)"
    },
"notif_invites": {
      "type": "boolean",
      "default": true,
      "description": "Recibir notificaciones de invitaciones a viajes — el campo faltaba en el schema y los 4 toggles de notificaciones de Settings.jsx nunca persistían"
    },
    "notif_expenses": {
      "type": "boolean",
      "default": true,
      "description": "Recibir notificaciones de gastos añadidos/liquidados"
    },
    "notif_comments": {
      "type": "boolean",
      "default": false,
      "description": "Recibir notificaciones de comentarios"
    },
    "spots_public_default": {
      "type": "boolean",
      "default": false,
      "description": "Visibilidad pública por defecto de spots nuevos"
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha/hora en que aceptó los Términos de Servicio y la Política de Privacidad — obligatorio antes de completar el registro (RGPD, consentimiento informado)"
    },
    "terms_version": {
      "type": "string",
      "description": "Versión de los Términos/Privacidad aceptada, para saber si hay que pedir re-aceptación cuando cambien"
    }
  },
  "required": [
    "user_id",
    "username",
    "username_normalized",
    "display_name"
  ],
  "rls": {
    // Antes read:true sin restricción — cualquier usuario logueado podía
    // volcar TODOS los campos de TODOS los perfiles con una sola llamada al
    // SDK (email, nationality, second_nationality incluidos), no solo lo que
    // mostraba la UI. En vez de partir la entidad en dos (público/privado,
    // lo que exigiría migrar los datos ya guardados), se cerró read a "solo
    // tu propio perfil" y se movieron todas las lecturas de OTROS perfiles a
    // la función backend searchUserProfiles, que solo devuelve los campos
    // que alguna pantalla de la app realmente pinta de otra persona
    // (username, display_name, avatar_url, cover_image_url, bio, website,
    // instagram, travel_style, home_country) — nunca nationality,
    // second_nationality, home_currency, language, notif_*, terms_*,
    // spots_public_default, que son ajustes de cuenta y solo se leen del
    // propio perfil en cualquier pantalla existente (confirmado revisando
    // cada sitio que consultaba UserProfile antes de este fix). El email SÍ
    // se devuelve cuando quien llama ya lo conocía de antemano (búsqueda por
    // email/userIds ya conocidos, p.ej. trip.members) — no divulga nada
    // nuevo — pero nunca en los modos de descubrimiento abierto (buscar por
    // username, listar todos). Ver base44/functions/searchUserProfiles/entry.ts
    // y src/lib/userProfiles.js.
    "create": { "data.user_id": "{{user.id}}" },
    "read": { "data.user_id": "{{user.id}}" },
    "update": { "data.user_id": "{{user.id}}" },
    "delete": { "data.user_id": "{{user.id}}" }
  }
}
